# Supabase Postgres connection (session pooler, IPv4). Use the `postgres` role: ingestion writes.
# Find it in Supabase: Project Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Optional: require (default: TLS without certificate verification), verify-full or disable.
# DATABASE_SSLMODE=require

# Fernet key used to encrypt the Garmin token stored in user_sessions.
# Generate one with: python -m filipides genkey
ENCRYPTION_KEY=

# Only used by `python -m filipides login` (first login, with MFA).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: UUID of the athlete in the users table. Detected automatically if there is a single user.
ATHLETE_USER_ID=
